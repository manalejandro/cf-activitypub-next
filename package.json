{
  "name": "cf-activitypub",
  "version": "1.1.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/manalejandro/cf-activitypub-next.git"
  },
  "scripts": {
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "predev": "npm run generate:openapi",
    "prebuild": "npm run generate:openapi",
    "prepreview": "npm run generate:openapi",
    "predeploy": "npm run generate:openapi",
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:migrate": "wrangler d1 execute cf-activitypub --remote --file=lib/db/schema.sql",
    "db:drop": "wrangler d1 execute cf-activitypub --remote --file=lib/db/drop.sql"
  },
  "dependencies": {
    "fork-awesome": "^1.2.0",
    "i18next": "^26.4.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.8.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.0.1",
    "swagger-ui-dist": "^5.32.14",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.35.0"
  }
}
