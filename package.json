{
  "name": "cf-activitypub",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/manalejandro/cf-activitypub-next.git"
  },
  "scripts": {
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "predev": "npm run generate:openapi",
    "prebuild": "npm run generate:openapi",
    "prepreview": "npm run generate:openapi",
    "predeploy": "npm run generate:openapi",
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:watch": "vitest",
    "lint": "eslint",
    "preview": "vite build && vite preview",
    "deploy": "vinext-cloudflare deploy",
    "db:migrate": "wrangler d1 execute cf-activitypub --remote --file=lib/db/schema.sql",
    "db:drop": "wrangler d1 execute cf-activitypub --remote --file=lib/db/drop.sql"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "fork-awesome": "^1.2.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.1.2",
    "swagger-ui-dist": "^5.33.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  }
}
