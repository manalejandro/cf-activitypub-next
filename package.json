{
  "name": "cf-activitypub",
  "version": "1.3.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/manalejandro/cf-activitypub-next.git"
  },
  "scripts": {
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "predev": "npm run generate:openapi",
    "prebuild": "npm run generate:openapi",
    "prepreview": "npm run generate:openapi",
    "predeploy": "npm run generate:openapi",
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:migrate": "wrangler d1 execute cf-activitypub --remote --file=lib/db/schema.sql",
    "db:drop": "wrangler d1 execute cf-activitypub --remote --file=lib/db/drop.sql"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@xyflow/react": "^12.11.6",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.2",
    "fork-awesome": "^1.2.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.1.1",
    "swagger-ui-dist": "^5.33.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  }
}
