{
  "name": "cf-activitypub",
  "version": "1.5.9",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/manalejandro/cf-activitypub-next.git"
  },
  "scripts": {
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:env": "node scripts/check-env-vars.mjs",
    "predev": "npm run generate:openapi",
    "prebuild": "npm run generate:openapi",
    "prepreview": "npm run generate:openapi",
    "predeploy": "npm run generate:openapi",
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:watch": "vitest",
    "lint": "eslint",
    "preview": "vite build && vite preview",
    "deploy": "vinext-cloudflare deploy",
    "db:migrate": "wrangler d1 execute cf-activitypub --remote --file=lib/db/schema.sql",
    "db:drop": "wrangler d1 execute cf-activitypub --remote --file=lib/db/drop.sql"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.158",
    "@cloudflare/ai-chat": "^0.12.2",
    "@xyflow/react": "^12.12.0",
    "agents": "^0.28.1",
    "ai": "^7.0.143",
    "d3-force": "^3.0.0",
    "fork-awesome": "^1.2.0",
    "i18next": "^26.5.11",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.1",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@next/eslint-plugin-next": "16.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.1.3",
    "swagger-ui-dist": "^5.34.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  }
}
